---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import { url } from "@lib/utils";

// The site's pages, in order: Overview (the home page, named SITE.NAME),
// Findings (the story) and Explore (the map), side by side and split by thin
// vertical lines (global.css .site-nav). Every page lists all three; the
// current page is full size and the others smaller until hovered or focused.
// `url()` adds the site's base path.
const pages = [
  { href: url(), label: SITE.NAME },
  { href: url("scrollytelling"), label: "Findings" },
  { href: url("full_page_map"), label: "Explore" },
];
const strip = (path: string) => path.replace(/\/+$/, "");
const here = strip(Astro.url.pathname);
const others = pages;
---

<header>
  <Container>
    <nav class="site-nav" aria-label="Pages">
      {others.map((page) => (
        <a href={page.href} data-label={page.label} aria-current={strip(page.href) === here ? "page" : undefined}>{page.label}</a>
      ))}
    </nav>
  </Container>
</header>

---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import { url } from "@lib/utils";

// The links in the header. `url()` adds the site's base path (see astro.config.mjs).
const nav = [
  { href: url("full_page_map"), label: "Growth Periods" },
  { href: url("hydrography"), label: "Hydrography" },
  { href: url("scrollytelling"), label: "Scrollytelling" },
];

// The page being viewed gets aria-current="page", styled bold #c2d96b in global.css.
const strip = (path: string) => path.replace(/\/+$/, "");
const here = strip(Astro.url.pathname);
---

<header>
  <Container>
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-between items-center">
      <a href={url()} class="font-semibold" aria-current={here === strip(url()) ? "page" : undefined}>
        {SITE.NAME}
      </a>
      <nav class="hidden sm:flex gap-4 text-sm">
        {nav.map((item) => (
          <a href={item.href} aria-current={here === strip(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </Container>
</header>

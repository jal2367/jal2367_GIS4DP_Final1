---
import PageLayout from "@layouts/PageLayout.astro";
import { HOME, SITE } from "@consts";
import { url } from "@lib/utils";

// Overview: the thesis project proposal. A side panel on the left like the
// Explore and Findings pages: the page links on top, then a table of
// contents that jumps to each section below (and follows your scrolling).
// To add, remove or rename a section, edit this list; each gets a heading
// and a placeholder paragraph to replace with your text. `sub` nests
// subsections under a section (numbered 05.1, 05.2...).
const outline = [
  { id: "introduction", title: "Introduction" },
  { id: "literature-review", title: "Literature Review" },
  { id: "historical-review", title: "Historical Review" },
  { id: "theoretical-framework", title: "Theoretical Framework" },
  { id: "methodology", title: "Methodology", sub: [
    { id: "quantitative-research", title: "Quantitative Research" },
    { id: "qualitative-research", title: "Qualitative Research" },
    { id: "analysis", title: "Analysis" },
  ] },
  { id: "climate-change-implications", title: "Climate Change Implications", sub: [
    { id: "stormwater-drainage", title: "Santiago's Stormwater Drainage System" },
    { id: "el-nino-2026", title: "El Niño 2026" },
  ] },
  { id: "conclusion", title: "Conclusion" },
  { id: "action", title: "Action" },
];
// Flattened in reading order, with numbers ("05" for sections, "5.1" for
// subsections), depth and the parent section's id.
const sections = outline.flatMap((s, i) => {
  const n = String(i + 1).padStart(2, "0");
  return [
    { ...s, num: n, depth: 0, parent: s.id, hasSub: !!(s.sub && s.sub.length) },
    ...(s.sub || []).map((c, j) => ({ ...c, num: `${i + 1}.${j + 1}`, depth: 1, parent: s.id, hasSub: false })),
  ];
});
const pages = [
  { href: url(), label: SITE.NAME, current: true },
  { href: url("scrollytelling"), label: "Findings" },
  { href: url("full_page_map"), label: "Explore" },
];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <aside class="overview-panel" aria-label="Contents">
    <div class="rail-brand">
      <nav class="site-nav rail-site-nav" aria-label="Pages">
        {pages.map((page) => (
          <a href={page.href} data-label={page.label} aria-current={page.current ? "page" : undefined}>{page.label}</a>
        ))}
      </nav>
    </div>
    <nav class="overview-toc" aria-label="Table of contents">
      <ol>
        {sections.map((section) => (
          <li class:list={{ "toc-sub": section.depth === 1, "toc-has-sub": section.hasSub }} data-parent={section.parent}>
            <a href={`#${section.id}`} data-toc={section.id}>
              <span class="toc-num">{section.num}</span>
              {section.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>

  <div class="overview-body">
    <p class="overview-kicker">Thesis project proposal</p>
    <h1 class="overview-title">Santiago, 1680–2024</h1>
    {sections.map((section) => (
      <section id={section.id} class:list={["overview-section", { "overview-subsection": section.depth === 1 }]}>
        {section.depth === 1
          ? <h3><span class="toc-num">{section.num}</span> {section.title}</h3>
          : <h2><span class="toc-num">{section.num}</span> {section.title}</h2>}
        <p>[Write your {section.title.toLowerCase()} here.]</p>
      </section>
    ))}
  </div>
</PageLayout>

<script>
  // Highlight the section you are reading in the table of contents: the last
  // one whose top has scrolled up near the top of the window.
  // Subsections stay folded in the contents unless you are reading that
  // section (or one of its subsections) or clicked its main entry.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const sections = [...document.querySelectorAll<HTMLElement>(".overview-section")];
  const items = [...document.querySelectorAll<HTMLElement>(".overview-toc li")];
  let clicked: string | null = null;
  function update() {
    const line = 80; // px: just below where a jump lands (scroll-margin 2rem)
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
    for (const a of links) {
      if (a.dataset.toc === current?.id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
    const reading = items.find((li) => li.querySelector(`[data-toc="${current?.id}"]`))?.dataset.parent;
    for (const li of items) {
      const open = li.dataset.parent === reading || li.dataset.parent === clicked;
      if (li.classList.contains("toc-sub")) li.classList.toggle("is-folded", !open);
      if (li.classList.contains("toc-has-sub")) li.classList.toggle("is-open", open);
    }
  }
  // Clicking a main entry opens its subsections (until another is clicked).
  for (const li of items) {
    if (li.classList.contains("toc-sub")) continue;
    li.querySelector("a")?.addEventListener("click", () => { clicked = li.dataset.parent || null; update(); });
  }
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
</script>

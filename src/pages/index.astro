---
import PageLayout from "@layouts/PageLayout.astro";
import { HOME, SITE } from "@consts";
import { url } from "@lib/utils";

// Overview: the thesis project proposal. A side panel on the left like the
// Explore and Findings pages: the page links on top, then a table of
// contents that jumps to each section below (and follows your scrolling).
// To add, remove or rename a section, edit this list; each gets a heading
// and a placeholder paragraph to replace with your text.
const sections = [
  { id: "introduction", title: "Introduction" },
  { id: "literature-review", title: "Literature Review" },
  { id: "historical-review", title: "Historical Review" },
  { id: "theoretical-framework", title: "Theoretical Framework" },
  { id: "methodology", title: "Methodology" },
  { id: "quantitative-research", title: "Quantitative Research" },
  { id: "qualitative-research", title: "Qualitative Research" },
  { id: "analysis", title: "Analysis" },
  { id: "conclusion", title: "Conclusion" },
  { id: "action", title: "Action" },
];
const pages = [
  { href: url(), label: SITE.NAME, current: true },
  { href: url("scrollytelling"), label: "Findings" },
  { href: url("full_page_map"), label: "Explore" },
];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <aside class="overview-panel" aria-label="Contents">
    <div class="rail-brand">
      <nav class="site-nav rail-site-nav" aria-label="Pages">
        {pages.map((page) => (
          <a href={page.href} data-label={page.label} aria-current={page.current ? "page" : undefined}>{page.label}</a>
        ))}
      </nav>
    </div>
    <nav class="overview-toc" aria-label="Table of contents">
      <ol>
        {sections.map((section, i) => (
          <li>
            <a href={`#${section.id}`} data-toc={section.id}>
              <span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
              {section.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>

  <div class="overview-body">
    <p class="overview-kicker">Thesis project proposal</p>
    <h1 class="overview-title">Santiago, 1680–2024</h1>
    {sections.map((section, i) => (
      <section id={section.id} class="overview-section">
        <h2><span class="toc-num">{String(i + 1).padStart(2, "0")}</span> {section.title}</h2>
        <p>[Write your {section.title.toLowerCase()} here.]</p>
      </section>
    ))}
  </div>
</PageLayout>

<script>
  // Highlight the section you are reading in the table of contents: the last
  // one whose top has scrolled up near the top of the window.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const sections = [...document.querySelectorAll<HTMLElement>(".overview-section")];
  function update() {
    const line = 80; // px: just below where a jump lands (scroll-margin 2rem)
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
    for (const a of links) {
      if (a.dataset.toc === current?.id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  }
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
</script>

---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE } from "@consts";
import { url } from "@lib/utils";

// Methodology: how each layer group on the Explore map was made. Each
// side-panel section on Explore links here (#urbanization, #hydrography...).
// Items marked TO FILL (yellow dashed boxes, .todo) are for the author to
// complete: data origins, citations and steps done outside this site.
const groups = [
  { id: "urbanization", title: "Urbanization", color: "#ff0080" },
  { id: "hydrography", title: "Hydrography", color: "#00ffff" },
  { id: "puntos-criticos", title: "Puntos críticos & Risk Hotspots", color: "#ff00ff" },
  { id: "base-map", title: "Base map", color: "#c6ff33" },
  { id: "social", title: "Social", color: "#c070ff" },
  { id: "criticos-placeholder", title: "Puntos críticos (orange)", color: "#ffa31a" },
];
const pages = [
  { href: url(), label: SITE.NAME },
  { href: url("scrollytelling"), label: "Findings" },
  { href: url("full_page_map"), label: "Explore" },
];

// Flowchart of the urbanization method: [x, y, w, h, kind, title, lines].
// kind: input | step | todo | output. Coordinates in a 720-wide viewBox.
const W = 720;
type Box = [number, number, number, number, "input" | "step" | "todo" | "output", string, string[]];
const boxes: Box[] = [
  [20, 20, 210, 88, "todo", "Built_Hist_2024", ["Built area by year built", "(crecimiento), 1541–2024", "TO FILL: source"]],
  [255, 20, 210, 88, "input", "500 m hexagon grid", ["Flat-top hexagons,", "500 m flat to flat"]],
  [490, 20, 210, 88, "input", "Comuna boundaries", ["32 comunas,", "Province of Santiago"]],
  [20, 130, 680, 56, "step", "1 · Intersect", ["Built polygons clipped to each hexagon (area per year, UTM 19S); comuna by hexagon centre"]],
  [20, 210, 680, 56, "step", "2 · Summarize per hexagon", ["Earliest, latest and area-weighted mean year; built area (ha and % of hexagon)"]],
  [20, 290, 680, 56, "step", "3 · Keep hexagons ≥ 10% built", ["11,307 hexagons"]],
  [20, 370, 680, 56, "step", "4 · Urbanization rate", ["Built ha ÷ years it took to build (ha/yr)"]],
  [20, 450, 680, 56, "step", "5 · Classify & size", ["Colour: 5 natural breaks of the mean year · Size: urbanization rate"]],
  [20, 530, 680, 56, "output", "Urbanization layer · Explore", ["Reprojected to EPSG:4326 for the web map"]],
];
const arrows = [
  "M125,108 V128", "M360,108 V128", "M595,108 V128",
  "M360,186 V208", "M360,266 V288", "M360,346 V368", "M360,426 V448", "M360,506 V528",
];
const H = 606;
---

<PageLayout title="Methodology" description={SITE.DESCRIPTION}>
  <aside class="overview-panel" aria-label="Methodology contents">
    <div class="rail-brand">
      <nav class="site-nav rail-site-nav" aria-label="Pages">
        {pages.map((page) => <a href={page.href} data-label={page.label}>{page.label}</a>)}
      </nav>
    </div>
    <nav class="overview-toc" aria-label="Layer groups">
      <ol>
        {groups.map((g, i) => (
          <li>
            <a href={`#${g.id}`} data-toc={g.id} style={`--gc:${g.color}`}>
              <span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
              {g.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    {/* Return: back to the Explore map exactly as it was (script below),
        pinned to the bottom like Explore's Methodology button. */}
    <div class="side-panel-method method-return-foot">
      <a href={url("full_page_map")} id="method-return">← Return</a>
    </div>
  </aside>

  <div class="overview-body methodology">
    <p class="overview-kicker">Explore · how the layers were made</p>
    <h1 class="overview-title">Methodology</h1>
    <p class="todo-legend"><span class="todo-tag">TO FILL</span> marks sources and steps the author still has to complete.</p>

    <section id="urbanization" class="overview-section" style="--gc:#ff0080">
      <h2><span class="toc-num">01</span> Urbanization</h2>
      <p>
        How the city's built footprint grew: a 500 m hexagon grid summarizing the built-area
        layer <code>Built_Hist_2024</code> by the year each area was built (<code>crecimiento</code>).
      </p>

      <figure class="method-diagram">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="urb-diagram-title">
          <title id="urb-diagram-title">Urbanization layer methodology, from inputs to the web layer</title>
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
              <path d="M0,0 L10,5 L0,10 z" fill="#9aa0a6"></path>
            </marker>
          </defs>
          {arrows.map((d) => <path d={d} class="m-arrow" marker-end="url(#arrow)"></path>)}
          {boxes.map(([x, y, w, h, kind, title, lines]) => (
            <g class={`m-box m-${kind}`}>
              <rect x={x} y={y} width={w} height={h} rx="4"></rect>
              <text x={x + 12} y={y + 22} class="m-title">{title}</text>
              {lines.map((line, i) => (
                <text x={x + 12} y={y + 42 + i * 17} class="m-line">{line}</text>
              ))}
            </g>
          ))}
        </svg>
        <figcaption>
          Inputs on top (yellow dashed: source to fill in), steps in order, the map layer at the bottom.
        </figcaption>
      </figure>

      <h3>Sources</h3>
      <table class="m-sources">
        <thead><tr><th>Data</th><th>Source</th><th>Notes</th></tr></thead>
        <tbody>
          <tr class="todo-row">
            <td>Built_Hist_2024: Historic_Growth (1541–2000)</td>
            <td><span class="todo-tag">TO FILL</span> author, year, title, link</td>
            <td>Supplied by the author (Historic_Growth.shp).</td>
          </tr>
          <tr class="todo-row">
            <td>Built_Hist_2024: built area 2010 (Built_10_clip)</td>
            <td><span class="todo-tag">TO FILL</span> dataset, year, resolution, link</td>
            <td>Supplied by the author (Land Use – Cover / Built Poly).</td>
          </tr>
          <tr class="todo-row">
            <td>Built_Hist_2024: built area 2024 (Built_24_clip)</td>
            <td><span class="todo-tag">TO FILL</span> dataset, year, resolution, link</td>
            <td>Supplied by the author (Land Use – Cover / Built Poly).</td>
          </tr>
          <tr>
            <td>Comuna boundaries (32 comunas + 11 commuter-belt comunas)</td>
            <td>caracena, <em>chile-geojson</em>, Región Metropolitana file (13.geojson), GitHub: github.com/caracena/chile-geojson</td>
            <td>Downloaded for this site. <span class="todo-tag">TO FILL</span> check the original agency and license.</td>
          </tr>
          <tr>
            <td>500 m hexagon grid</td>
            <td>Generated for this site (flat-top hexagons, 500 m flat to flat, EPSG:8951 / UTM 19S)</td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <h3>Key decisions</h3>
      <ul class="m-decisions">
        <li><b>Area-weighted mean year.</b> Each hexagon's mean year weights every <code>crecimiento</code> year by the built area it covers inside the hexagon, not a simple average of the years present. A hexagon 90% built in 2010 and 10% in 1900 reads about 1999, not 1955, so small slivers of old fabric don't drag recent areas back in time.</li>
        <li><b>500 m hexagons.</b> Fine enough to follow the edge of the built area and its gaps (parks, rivers, industrial land) while keeping the web file light (about 4 MB).</li>
        <li><b>At least 10% built.</b> Hexagons that only graze scattered built patches are left out, so the layer represents urban surface rather than every cell touched by a building.</li>
        <li><b>Areas from geometry.</b> All areas are measured from the polygons in UTM zone 19S (true metres), not taken from the source's stored area fields.</li>
        <li><b>Urbanization rate.</b> Built hectares divided by the years it took to build, counted from the map date before the earliest year present (the source maps are dated 1541, 1600, 1900, 1920, 1940, 1952, 1960, 1970, 1982, 1996, 1998, 2000, 2010 and 2024) to the latest. A hexagon built entirely by 2010 counts as built over 2000–2010.</li>
        <li><b>Natural breaks (Jenks), 5 classes</b> of the area-weighted mean year for colour, so periods follow the data rather than fixed dates.</li>
        <li><b>Size cap at the 90th percentile.</b> Hexagon width runs from 20% (0 ha/yr) to 100% at 1.15 ha/yr, so a few extreme values don't shrink everything else.</li>
        <li><b>Comuna assignment by centre.</b> Each hexagon belongs to the comuna that contains its centre. Comuna figures (built area 2000 and 2024, growth, rates) use all built area inside the comuna, before the 10% filter.</li>
      </ul>

      <h3>Key figures</h3>
      <ul class="m-figures">
        <li>Built area: <b>1,373.5 km²</b> in the region, 658 km² in the 32 comunas (2024).</li>
        <li>Hexagons: <b>11,307</b> (at least 10% built).</li>
        <li>Periods (natural breaks of the area-weighted mean year): 1576–1751 · 1752–1934 · 1935–1977 · 1978–2004 · 2005–2024.</li>
        <li>Urbanization rate per hexagon: 0.02–10.8 ha/yr, median 0.40; full size from 1.15 ha/yr (90th percentile).</li>
        <li>Built footprint of the region: 35 km² (1900) · 104 (1940) · 314 (1970) · 696 (2000) · 1,179 (2010) · 1,374 (2024).</li>
      </ul>

      <h3>Limitations</h3>
      <ul>
        <li>The 2000 class mixes a historic growth ring with outlying towns mapped at that date, so 1998→2000 is not a real two-year change.</li>
        <li>2010 and 2024 come from a different kind of source (land cover) than the historic growth map; part of the 2000–2010 jump may be a change of method.</li>
        <li>Comuna figures assign each hexagon to the comuna containing its centre.</li>
        <li><span class="todo-tag">TO FILL</span> other limitations (e.g. accuracy of the source maps).</li>
      </ul>
    </section>

    <section id="hydrography" class="overview-section" style="--gc:#00ffff">
      <h2><span class="toc-num">02</span> Hydrography</h2>
      <p>Natural and engineered water: rivers, streams and ravines, and the canals, reservoirs and storm collector network built around them.</p>

      <h3>Steps</h3>
      <ol class="m-steps">
        <li><b>Group the CAD layers by type.</b> The source's drawing layers become five types:
          Rivers (RIO) · Streams (ESTERO) · Ravines (QUEBRADA, permanent and intermittent) ·
          Canals (CANAL, ACUEDUCTO, including tunnels) · Reservoirs and ponds (EMBALSE, TRANQUE).</li>
        <li><b>Drop what isn't water:</b> CAD audit leftovers, unlabelled lines ("ca") and mining tailings dams (TRANQUE DE RELAVE).</li>
        <li><b>Lighten for the web:</b> lines simplified to 8 m, coordinates rounded to about 1 m, fragments under 1 m removed, and all lines of a type merged into one feature (9.1 → 4.3 MB).</li>
        <li><b>Collector network:</b> cut to the Región Metropolitana (1,265 of 2,937 lines), keeping name, length and update date; simplified to 5 m (1.0 → 0.4 MB).</li>
        <li><b>Style:</b> each type drawn with a glow; width, opacity and glow step down with size.</li>
      </ol>

      <h3>Key decisions</h3>
      <ul class="m-decisions">
        <li><b>Natural vs engineered.</b> Rivers, streams and ravines are natural features (aquamarine, deepest for rivers to palest for ravines). Canals, reservoirs and the collector network are engineered (dark violet, deepest for the collector to palest for reservoirs). Reservoirs and ponds count as engineered because most are man-made (embalses, tranques).</li>
        <li><b>Visual hierarchy by size.</b> Rivers 3–8 px wide at full opacity with a strong glow, down to ravines 0.4–1 px, dashed, at 45%.</li>
        <li><b>Whole region, not clipped</b> to the 32 comunas, so rivers and ravines read as continuous systems from the Andes.</li>
        <li><b>Engineered features start off</b> to keep the opening map readable; natural features start on.</li>
      </ul>

      <h3>Sources</h3>
      <table class="m-sources">
        <thead><tr><th>Data</th><th>Source</th><th>Notes</th></tr></thead>
        <tbody>
          <tr class="todo-row">
            <td>Hydrography (Hydrografia2)</td>
            <td><span class="todo-tag">TO FILL</span> agency, dataset, date, link</td>
            <td>Supplied by the author as a CAD-derived GeoJSON (EPSG:4326), 25,025 lines.</td>
          </tr>
          <tr class="todo-row">
            <td>Collector network (Sistema Colector)</td>
            <td>Dirección de Obras Hidráulicas (DOH). <span class="todo-tag">TO FILL</span> dataset name, date, link</td>
            <td>Supplied by the author (EPSG:4326), 2,937 lines nationwide.</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section id="puntos-criticos" class="overview-section" style="--gc:#ff00ff">
      <h2><span class="toc-num">03</span> Puntos críticos &amp; Risk Hotspots</h2>
      <p>Winter critical points (flooding, overflow and drainage problems) identified for the 2026 winter programme, and where serious risk concentrates.</p>

      <h3>Steps</h3>
      <ol class="m-steps">
        <li><b>Download</b> from SENAPRED's public ArcGIS service, filtered to the Región Metropolitana: 2,320 of 15,552 points nationwide, already in EPSG:4326.</li>
        <li><b>Keep the fields used:</b> risk level (<code>nivel_de_riesgo</code>), comuna, sector, cause, main action and solution type.</li>
        <li><b>Points:</b> one layer per risk level, graduated magenta from dim and small (Bajo) to bright and large with a glow (Muy Alto).</li>
        <li><b>Risk Hotspots:</b> a kernel density surface of the points (MapLibre heatmap), weighted by risk level, in the same magenta ramp.</li>
        <li><b>Comuna counts:</b> points inside each comuna's boundary, by risk level, shown in the comuna panel.</li>
      </ol>

      <h3>Key decisions</h3>
      <ul class="m-decisions">
        <li><b>Risk-weighted density.</b> Each point counts by its risk level: Bajo 0.5, Medio 1, Alto 3, Muy Alto 8. One Muy Alto point outweighs 16 Bajo ones, so hotspots show where serious risk concentrates rather than simply where points are numerous.</li>
        <li><b>Kernel radius grows with zoom</b> (about 22 px at zoom 9 to 90 px at zoom 15), so the surface stays smooth at every scale.</li>
        <li><b>Point-in-polygon for comunas.</b> Comuna counts and the study-area table test each point against the 32 comuna boundaries, rather than trusting the comuna name in the source.</li>
        <li><b>Off at start,</b> so the opening map focuses on urbanization and water.</li>
      </ul>

      <h3>Key figures</h3>
      <ul class="m-figures">
        <li>Región Metropolitana: <b>2,320</b> points · Muy Alto 405 · Alto 790 · Medio 797 · Bajo 328.</li>
        <li>32 comunas (study area): <b>1,179</b> points · Muy Alto 189 · Alto 407 · Medio 405 · Bajo 178.</li>
      </ul>

      <h3>Sources</h3>
      <table class="m-sources">
        <thead><tr><th>Data</th><th>Source</th><th>Notes</th></tr></thead>
        <tbody>
          <tr>
            <td>Puntos críticos de invierno 2026</td>
            <td>SENAPRED, <em>Puntos Críticos Invierno 2026</em> (Programa Invierno), ArcGIS MapServer
              <code>visor-grd.senapred.gob.cl/arcgis/rest/services/PROG_INVIERNO_2/Puntos_Criticos_INV_2026/MapServer/0</code>, accessed 22 November 2026.</td>
            <td>A snapshot: later updates to SENAPRED's list are not included.</td>
          </tr>
        </tbody>
      </table>

      <h3>Limitations</h3>
      <ul>
        <li>Points mark reported problem locations, not measured flood extents.</li>
        <li><span class="todo-tag">TO FILL</span> how SENAPRED assigns risk levels.</li>
      </ul>
    </section>

    <section id="base-map" class="overview-section" style="--gc:#c6ff33">
      <h2><span class="toc-num">04</span> Base map</h2>
      <p>Dark, low-contrast context under the data layers: terrain, optional satellite imagery and comuna boundaries.</p>

      <h3>Key decisions</h3>
      <ul class="m-decisions">
        <li><b>Dark, desaturated base.</b> Satellite imagery in grayscale at 25% brightness, rising slightly (to 40%) when zoomed in; hill shading darkened; road and ground vector layers hidden and 3D buildings removed, so the data layers carry the map.</li>
        <li><b>Terrain</b> elevation exaggerated 1.5× to read the Andes and the valley.</li>
        <li><b>Higher-resolution satellite</b> (MapTiler) chosen over a dated but coarser mosaic; satellite starts off.</li>
        <li><b>Study area and context.</b> The 32 comunas of the Province of Santiago in solid lines (clickable, filterable); 11 commuter-belt comunas outside the province (Puente Alto, San Bernardo, Padre Hurtado, Pirque, Colina, Lampa, Calera de Tango, Buin, Paine, Talagante, Peñaflor) dashed, for context only. San José de Maipo is left out: its boundary covers a large stretch of the Andes.</li>
        <li><b>Map limits:</b> zoom-out stops at the Province of Santiago and panning stays around it.</li>
      </ul>

      <h3>Sources</h3>
      <table class="m-sources">
        <thead><tr><th>Data</th><th>Source</th><th>Notes</th></tr></thead>
        <tbody>
          <tr>
            <td>Satellite imagery, terrain, base style and fonts</td>
            <td>MapTiler (satellite-v2, terrain-rgb-v2), © MapTiler © OpenStreetMap contributors</td>
            <td>Imagery acquisition date not published.</td>
          </tr>
          <tr>
            <td>Comuna boundaries and labels</td>
            <td>caracena, <em>chile-geojson</em>, Región Metropolitana file, github.com/caracena/chile-geojson</td>
            <td>Label points made from the boundaries. <span class="todo-tag">TO FILL</span> original agency and license.</td>
          </tr>
          <tr>
            <td>Map label typeface</td>
            <td>JetBrains Mono (SIL Open Font License), self-hosted</td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </section>

    <section id="social" class="overview-section m-pending" style="--gc:#c070ff">
      <h2><span class="toc-num">05</span> Social</h2>
      <p class="todo-block"><span class="todo-tag">TO FILL</span> Placeholder layer: data, sources and steps to come.</p>
    </section>

    <section id="criticos-placeholder" class="overview-section m-pending" style="--gc:#ffa31a">
      <h2><span class="toc-num">06</span> Puntos críticos (orange placeholder)</h2>
      <p class="todo-block"><span class="todo-tag">TO FILL</span> Placeholder layer: data, sources and steps to come.</p>
    </section>
  </div>
</PageLayout>

<script>
  // Highlight the group you are reading in the contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const sections = [...document.querySelectorAll<HTMLElement>(".overview-section")];
  function update() {
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= 80) current = s;
    for (const a of links) {
      if (a.dataset.toc === current?.id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  }
  window.addEventListener("scroll", update, { passive: true });
  update();

  // Return: if you came from the Explore map (it saved its view), go back to
  // it with that view restored; otherwise go back to the previous page.
  const back = document.getElementById("method-return") as HTMLAnchorElement | null;
  let saved = false;
  try { saved = !!sessionStorage.getItem("exploreReturnView"); } catch { /* ignore */ }
  if (back && saved) {
    back.href = back.href + "?from=methodology";
  } else if (back && document.referrer && new URL(document.referrer).origin === location.origin) {
    back.addEventListener("click", (e) => { e.preventDefault(); history.back(); });
  }
</script>
